# Copy to .env and fill in. Type values plainly: no quotes (and no curly "smart" quotes).

# --- required ---
ANTHROPIC_API_KEY=
# ElevenLabs key needs the "Text to Speech" permission turned on
ELEVENLABS_API_KEY=
# the ID of Bit's cloned voice (ElevenLabs > Voices > ... > Copy voice ID)
ELEVENLABS_VOICE_ID=

# --- recommended ---
# your city, for "what's the weather?"
BIT_HOME_CITY=
# speaker hidden in the real Bit, matched by part of its name (empty = Mac speakers)
BIT_AUDIO_DEVICE=

# --- optional (defaults shown) ---
# WAKE_MODEL=models/hey_bit.onnx      # or hey_jarvis (built in)
# WAKE_THRESHOLD=0.85                 # 0.5 for built-in wake words
# BIT_MIC_DEVICE=                     # empty = system default mic
# BIT_AV_OFFSET_MS=0                  # ~200 if the mouth runs ahead on a Bluetooth speaker
# BIT_CONTENT_PLAN=notes/next.md      # "what's next" = first unticked "- [ ]" line
# BIT_CONTENT_PLAN_URL=               # link for the "content plan" bookmark
# BIT_PLAYLIST_CHILL=spotify:playlist:37i9dQZF1DX4WYpdgoIcn6
# BIT_PLAYLIST_FOCUS=spotify:playlist:37i9dQZF1DWZeKCadgRdKQ
# BIT_PLAYLIST_HAPPY=spotify:playlist:37i9dQZF1DXdPec7aLTmlC
# BIT_FACE_PORT=8765
# ELEVENLABS_MODEL=eleven_flash_v2_5
# WHISPER_MODEL=base.en
